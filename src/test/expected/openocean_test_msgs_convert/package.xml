<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openocean_test_msgs_convert</name>
  <version>0.1.0</version>
  <description>Protobuf C++ library, and conversion to and from openocean_test_msgs</description>
  <maintainer email="toby@oceansoft.org">Toby Schneider</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>openocean_test_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>openocean_msgs_convert</depend>
  <depend>protobuf-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
