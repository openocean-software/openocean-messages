# nanopb size limits, so that every field is a fixed-size struct member rather than a callback
openocean.Navigation.speed                  max_count:2
openocean.Navigation.velocity               max_count:2
openocean.Navigation.VehicleMetadata.name   max_size:32
openocean.Navigation.custom                 max_count:8
openocean.ControlSetpoint.custom            max_count:8
openocean.CustomValue.*                     max_size:32
