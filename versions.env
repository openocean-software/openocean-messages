# Versions of the tools that init.sh and CI download, pinned in one place.
# Sourced by shell scripts, so KEY=value only.

# buf (Protobuf compatibility check): https://github.com/bufbuild/buf/releases
BUF_VERSION=1.73.0
BUF_SHA256=8f2986298ad08f0cc1bf999b9797b7c383adf32d7edf0f73d6f1e1a701baeac1

# ros2-apt-source (ROS 2 apt repository): https://github.com/ros-infrastructure/ros-apt-source/releases
ROS_APT_SOURCE_VERSION=1.3.0

# ROS 2 distribution for each Ubuntu release (by codename)
ROS_DISTRO_NOBLE=jazzy
ROS_DISTRO_RESOLUTE=lyrical
