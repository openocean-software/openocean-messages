# find_package(openocean_messages [COMPONENTS cpp nanopb lcm python])
#
# Components are the outputs that were installed (possibly by separate packages):
#   cpp     openocean_messages::openocean_messages
#   nanopb  openocean_messages::nanopb
#   lcm     openocean_messages::lcm, and with cpp, openocean_messages::lcm_convert
#   python  openocean_messages_PYTHON_DIR (for PYTHONPATH)
#
# openocean_messages_PROTO_DIR is the import directory for openocean/messages/*.proto, and
# openocean_messages_GENERATORS_DIR (added to CMAKE_MODULE_PATH) has the ProtobufGenerateRos and
# ProtobufGenerateLcm modules.

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(openocean_messages_PROTO_DIR "@PACKAGE_OPENOCEAN_CONFIG_PROTO_DIR@")
set(openocean_messages_GENERATORS_DIR "@PACKAGE_OPENOCEAN_CONFIG_GENERATORS_DIR@")
set(openocean_messages_PYTHON_DIR "@PACKAGE_OPENOCEAN_CONFIG_PYTHON_DIR@")
list(APPEND CMAKE_MODULE_PATH ${openocean_messages_GENERATORS_DIR})

# Only the requested components, since e.g. cpp needs a C++ compiler for find_dependency(Protobuf)
set(_openocean_components ${openocean_messages_FIND_COMPONENTS})
if(NOT _openocean_components)
  set(_openocean_components cpp nanopb lcm python)
endif()
foreach(_openocean_component cpp nanopb lcm python)
  list(FIND _openocean_components ${_openocean_component} _openocean_index)
  set(_openocean_want_${_openocean_component} ${_openocean_index})
endforeach()
# lcm_convert links openocean_messages::openocean_messages
if(_openocean_want_lcm GREATER -1)
  set(_openocean_want_cpp 0)
endif()

if(_openocean_want_cpp GREATER -1 AND EXISTS ${CMAKE_CURRENT_LIST_DIR}/openocean_messages-cpp-targets.cmake)
  find_dependency(Protobuf)
  include(${CMAKE_CURRENT_LIST_DIR}/openocean_messages-cpp-targets.cmake)
  set(openocean_messages_cpp_FOUND TRUE)
endif()
if(_openocean_want_nanopb GREATER -1 AND EXISTS ${CMAKE_CURRENT_LIST_DIR}/openocean_messages-nanopb-targets.cmake)
  find_dependency(nanopb CONFIG)
  include(${CMAKE_CURRENT_LIST_DIR}/openocean_messages-nanopb-targets.cmake)
  set(openocean_messages_nanopb_FOUND TRUE)
endif()
if(_openocean_want_lcm GREATER -1 AND EXISTS ${CMAKE_CURRENT_LIST_DIR}/openocean_messages-lcm-targets.cmake)
  include(${CMAKE_CURRENT_LIST_DIR}/openocean_messages-lcm-targets.cmake)
  set(openocean_messages_lcm_FOUND TRUE)
endif()
if(EXISTS ${openocean_messages_PYTHON_DIR}/openocean/messages/navigation_pb2.py)
  set(openocean_messages_python_FOUND TRUE)
endif()

check_required_components(openocean_messages)
